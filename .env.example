# ==== Порт и адрес ====
PORT=3000

# ==== БД (для PostgreSQL поменяйте provider в prisma/schema.prisma и эту строку) ====
DATABASE_URL="file:./dev.db"

# ==== JWT ====
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ==== Админ по умолчанию (создаётся при первом запуске / seed) ====
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# ==== Данные магазина ====
SHOP_NAME="AKB Бишкек"
SHOP_PHONE="+996 700 123 456"
SHOP_WHATSAPP="996700123456"

# ==== Онлайн-оплата ====
# test — имитация оплаты (работает без подключения провайдера).
# При подключении реального провайдера (ecom.kg / OptiPay / Redpay)
# поменяйте значение и добавьте ключи провайдера (shop_id и секретный ключ).
PAYMENT_PROVIDER=test
# Секрет для webhook: провайдер подписывает им уведомления об оплате.
PAYMENT_WEBHOOK_SECRET=change-me-payment-secret
# Внешний адрес сайта — нужен для ссылки на оплату (замените на свой домен).
BASE_URL=http://localhost:3000
