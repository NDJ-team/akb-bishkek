{
  "name": "akb-bishkek",
  "version": "1.0.0",
  "description": "Лендинг продажи автомобильных аккумуляторов в Бишкеке + админ-панель",
  "main": "server/app.js",
  "scripts": {
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "db:push": "prisma db push",
    "db:seed": "node server/database/run-seed.js",
    "predev": "prisma generate && prisma db push",
    "dev": "nodemon server/app.js",
    "prestart": "prisma generate && prisma db push",
    "start": "node server/app.js",
    "build": "node server/utils/build.js",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "аккумуляторы",
    "бишкек",
    "akb",
    "лендинг"
  ],
  "author": "AKB Бишкек",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0",
    "terser": "^5.31.3"
  },
  "prisma": {
    "seed": "node server/database/run-seed.js"
  }
}
